# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Release signing secrets (never commit)
/android/key.properties
*.jks
*.keystore

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local environment secrets and machine-only configs
.env
.env.*
!.env.example

# Local diagnostics output
*.out
*.err

# Generated analyze dumps (regenerate with `flutter analyze`)
analyze_machine_output.txt

# Container build artifacts copied out of the named volume by
# `docker compose run --rm build-apk` / `build-web`. Never committed:
# the APK is a build output and the web bundle is reproducible.
/docker-out/

# Incoming third-party fashion dataset. Rights unverified; must never be committed.
/training_data/

